ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE} AS base

ARG DEBIAN_FRONTEND=noninteractive

ARG PYTHON="python3.12"

# install python
COPY docker/install_system.sh .
RUN bash install_system.sh && rm install_system.sh

# Install the pinned recommended CPU PyTorch stack.
COPY ci/requirements/recommended.txt /tmp/recommended.txt
RUN python -m pip install --no-cache-dir -r /tmp/recommended.txt && rm /tmp/recommended.txt

# Install the notebook-capable user-facing package image while retaining the pins.
COPY . /mr2/
RUN python -m pip install "/mr2[notebooks]" --no-cache-dir && rm -rf /mr2

# set user
USER runner
ENV PATH="/github/home/.local/bin:/home/runner/.local/bin:${PATH}"
